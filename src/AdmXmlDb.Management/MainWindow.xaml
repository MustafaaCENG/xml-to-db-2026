<Window x:Class="AdmXmlDb.Management.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdmXmlDb.Management"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:core="clr-namespace:AdmXmlDb.Core;assembly=AdmXmlDb.Core"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="AdmXmlDb - XML to Database Integration" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        WindowStyle="SingleBorderWindow"
        Icon="pack://application:,,,/AdmXmlDb.Management;component/Assets/Logo.png">
    <Window.Resources>
        <ObjectDataProvider x:Key="SqlTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="core:SqlDataType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Image Source="pack://application:,,,/AdmXmlDb.Management;component/Assets/Logo.png" Height="32" Stretch="Uniform" HorizontalAlignment="Left"/>
        </Border>
        <TabControl Grid.Row="1" Style="{StaticResource SidebarTabControlStyle}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource SidebarTabItem}"/>
            </TabControl.Resources>
                    <TabItem Header="Dashboard">
                        <Grid Margin="24,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="24" Margin="0,0,0,20" Background="#334155"
                                    BorderBrush="#475569" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Server" Width="36" Height="36"
                                                             VerticalAlignment="Center" Margin="0,0,20,0" Foreground="#6366F1"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="AdmXmlDbWorker Servisi" FontWeight="SemiBold" FontSize="16" Foreground="#F8FAFC"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Margin="0,0,10,0"
                                                     VerticalAlignment="Center" Fill="Gray"/>
                                            <TextBlock x:Name="ServiceStatusText" Text="Kontrol ediliyor..." VerticalAlignment="Center" Foreground="#94A3B8" FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="RefreshStatusBtn" Grid.Column="2" Content="Yenile"
                                            Click="RefreshStatusBtn_Click"
                                            Style="{StaticResource VisibleOutlinedButton}"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="RefreshLogsBtn" Content="Logları Yenile" Click="RefreshLogsBtn_Click"
                                        Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,12,0"/>
                                <Button x:Name="CleanLogsBtn" Content="Eski Logları Temizle (90 gün)" Click="CleanLogsBtn_Click"
                                        Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,12,0"/>
                                <TextBlock x:Name="LogPageInfo" Text="Sayfa 1" VerticalAlignment="Center" Margin="16,0,0,0"
                                           FontWeight="Medium" Foreground="#94A3B8" FontSize="14"/>
                                <Button x:Name="LogPrevBtn" Content="Önceki" Click="LogPrevBtn_Click"
                                        Style="{StaticResource VisibleTextButton}" Margin="12,0,0,0"/>
                                <Button x:Name="LogNextBtn" Content="Sonraki" Click="LogNextBtn_Click"
                                        Style="{StaticResource VisibleTextButton}" Margin="4,0,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="2" Padding="0" Background="#334155" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="12">
                                <DataGrid x:Name="LogsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Task" Binding="{Binding TaskName}" Width="*"/>
                                        <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="General Settings">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
                            <Border MaxWidth="500" Padding="28" Background="#334155" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                                        <materialDesign:PackIcon Kind="Email" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#6366F1"/>
                                        <TextBlock Text="SMTP Ayarları" FontWeight="SemiBold" FontSize="17" Foreground="#F8FAFC"/>
                                        <TextBlock Text=" — Hata bildirimleri için" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBox x:Name="SmtpHost" materialDesign:HintAssist.Hint="SMTP sunucu adresi" Margin="0,0,0,16"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <TextBox x:Name="SmtpPort" materialDesign:HintAssist.Hint="Port (örn: 587)" Text="587" Margin="0,0,0,16"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <CheckBox x:Name="SmtpUseSsl" Content="SSL kullan" Margin="0,0,0,16"
                                              Style="{StaticResource MaterialDesignCheckBox}"/>
                                    <TextBox x:Name="SmtpUsername" materialDesign:HintAssist.Hint="Kullanıcı adı" Margin="0,0,0,16"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <PasswordBox x:Name="SmtpPassword" materialDesign:HintAssist.Hint="Şifre" Margin="0,0,0,16"
                                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                                    <TextBox x:Name="SmtpSender" materialDesign:HintAssist.Hint="Gönderen e-posta" Margin="0,0,0,24"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveSmtpBtn" Content="Kaydet" Click="SaveSmtpBtn_Click"
                                                Style="{StaticResource PrimaryActionButton}" Margin="0,0,12,0"/>
                                        <Button x:Name="TestSmtpBtn" Content="Bağlantıyı Test Et" Click="TestSmtpBtn_Click"
                                                Style="{StaticResource VisibleOutlinedButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Task Management">
                        <Grid Margin="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Sol: Görev Listesi -->
                            <Border Grid.Row="0" Grid.Column="0" Padding="20" Margin="0,0,20,0" Background="#334155"
                                    BorderBrush="#475569" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#6366F1"/>
                                        <TextBlock Text="Görevler" FontWeight="SemiBold" FontSize="16" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                                            MinHeight="120">
                                        <ListBox x:Name="TasksList" DisplayMemberPath="Name"
                                                 SelectionChanged="TasksList_SelectionChanged"
                                                 BorderThickness="0" Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button x:Name="AddTaskBtn" Click="AddTaskBtn_Click"
                                                Style="{StaticResource PrimaryActionButton}" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" VerticalAlignment="Center"/>
                                                <TextBlock Text="Yeni Görev" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="DeleteTaskBtn" Click="DeleteTaskBtn_Click"
                                                Style="{StaticResource VisibleOutlinedButton}"
                                                ToolTip="Seçili görevi sil">
                                            <materialDesign:PackIcon Kind="Delete" Width="20" Height="20"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Sağ: Görev Ayarları + Örnek XML yan yana -->
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="400"/>
                                    <ColumnDefinition Width="*" MinWidth="320"/>
                                </Grid.ColumnDefinitions>
                                <!-- Sol: Görev Ayarları -->
                                <Border Grid.Column="0" Padding="24" Margin="0,0,12,0" Background="#334155"
                                        BorderBrush="#475569" BorderThickness="1" CornerRadius="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel MaxWidth="560">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#6366F1"/>
                                            <TextBlock Text="Görev Ayarları" FontWeight="SemiBold" FontSize="16" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBox x:Name="TaskName" materialDesign:HintAssist.Hint="Görev adı" Margin="0,0,0,20"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"/>

                                        <!-- Klasör Yolları -->
                                        <Border Style="{StaticResource SectionGroup}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="Folder" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                                    <TextBlock Text="Klasör Yolları" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskInputPath" IsReadOnly="True" Margin="0,0,10,0"
                                                             materialDesign:HintAssist.Hint="XML giriş klasörü"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <Button Grid.Column="1" Click="BrowseInputPath_Click"
                                                            Style="{StaticResource VisibleOutlinedButton}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Seç" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskOutputPath" IsReadOnly="True" Margin="0,0,10,0"
                                                             materialDesign:HintAssist.Hint="İşlenmiş dosya çıkış klasörü"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <Button Grid.Column="1" Click="BrowseOutputPath_Click"
                                                            Style="{StaticResource VisibleOutlinedButton}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Seç" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskErrorPath" IsReadOnly="True" Margin="0,0,10,0"
                                                             materialDesign:HintAssist.Hint="Hata dosyaları klasörü"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <Button Grid.Column="1" Click="BrowseErrorPath_Click"
                                                            Style="{StaticResource VisibleOutlinedButton}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Seç" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <TextBox x:Name="TaskPrependToFileName" materialDesign:HintAssist.Hint="Dosya ön eki (çıktı dosya adına eklenir)" Margin="0,12,0,0"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Veritabanı Ayarları -->
                                        <Border Style="{StaticResource SectionGroup}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="Database" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                                    <TextBlock Text="Veritabanı Ayarları" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskDbHost" materialDesign:HintAssist.Hint="Hostname veya IP" Margin="0,0,8,0"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <TextBox x:Name="TaskDbName" Grid.Column="1" materialDesign:HintAssist.Hint="Veritabanı adı"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskDbUser" materialDesign:HintAssist.Hint="Kullanıcı adı (boş=Windows Auth)" Margin="0,0,8,0"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <PasswordBox x:Name="TaskDbPassword" Grid.Column="1" materialDesign:HintAssist.Hint="Şifre"
                                                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                    <Button x:Name="TaskDbConnectBtn" Content="Bağlan" Click="TaskDbConnectBtn_Click"
                                                            Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,12,0"/>
                                                    <CheckBox x:Name="TaskUseConnectionString" Content="Gelişmiş (manuel bağlantı dizesi)" VerticalAlignment="Center"
                                                              Style="{StaticResource MaterialDesignCheckBox}" Checked="TaskUseConnectionString_Changed" Unchecked="TaskUseConnectionString_Changed"/>
                                                </StackPanel>
                                                <Border x:Name="TaskConnectionStringPanel" Visibility="Collapsed" Margin="0,0,0,12">
                                                    <TextBox x:Name="TaskConnectionString" materialDesign:HintAssist.Hint="Bağlantı dizesi"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                </Border>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TaskTableName" materialDesign:HintAssist.Hint="Hedef tablo (örn: ext.T_SO_DocumentExport)" Margin="0,0,10,0"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <Button Grid.Column="1" x:Name="TaskGetColumnsBtn" Content="Kolonları Getir" Click="TaskGetColumnsBtn_Click"
                                                            Style="{StaticResource VisibleOutlinedButton}"/>
                                                </Grid>
                                                <Border Background="#1E293B" CornerRadius="8" Padding="12" MaxHeight="120">
                                                    <ListBox x:Name="TaskColumnsList" BorderThickness="0" Background="Transparent"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Doküman Yapısı -->
                                        <Border Style="{StaticResource SectionGroup}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                                    <TextBlock Text="Doküman Yapısı" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <CheckBox x:Name="TaskMultiRecord" Content="Dokümanda birden fazla kayıt var" Margin="0,0,0,12"
                                                          Style="{StaticResource MaterialDesignCheckBox}"/>
                                                <TextBox x:Name="TaskMultiRecordXPath" materialDesign:HintAssist.Hint="Tekrarlanan kayıt için XPath (örn: //item)" Margin="0,0,0,12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBox x:Name="TaskTextToRemove" materialDesign:HintAssist.Hint="Kayıt sonrası kaldırılacak ifade" Margin="0,0,0,12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <Button x:Name="TaskTestXPathBtn" Content="XPath Test" Click="TaskTestXPathBtn_Click"
                                                        Style="{StaticResource VisibleOutlinedButton}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Hedef Dizin Yapısı -->
                                        <Border Style="{StaticResource SectionGroup}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="FolderOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                                    <TextBlock Text="Hedef Dizin Yapısı" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <TextBox x:Name="TaskStaticTargetDir" materialDesign:HintAssist.Hint="Statik temel dizin (örn: C:\archive)" Margin="0,0,0,12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBlock Text="Dinamik hedef yolu için XPath veya statik bileşenler (sıralı)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                                                <Border Background="#1E293B" CornerRadius="8" Padding="12" MaxHeight="100" Margin="0,0,0,12">
                                                    <ListBox x:Name="TargetDirComponentsList" DisplayMemberPath="DisplayValue" BorderThickness="0" Background="Transparent"/>
                                                </Border>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="TargetDirStaticInput" materialDesign:HintAssist.Hint="Statik Dizin veya XPath" Margin="0,0,8,0"
                                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="XPath Ekle" Click="TargetDirAddXPath_Click" Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,8,0"/>
                                                        <Button Content="Statik Ekle" Click="TargetDirAddStatic_Click" Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,8,0"/>
                                                        <Button Content="Sil" Click="TargetDirRemove_Click" Style="{StaticResource VisibleOutlinedButton}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Yukarı" Click="TargetDirMoveUp_Click" Style="{StaticResource VisibleTextButton}" Margin="0,0,8,0"/>
                                                    <Button Content="Aşağı" Click="TargetDirMoveDown_Click" Style="{StaticResource VisibleTextButton}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Zamanlama ve Bildirimler -->
                                        <Border Style="{StaticResource SectionGroup}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                                    <materialDesign:PackIcon Kind="Clock" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                                    <TextBlock Text="Zamanlama ve Bildirimler" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC"/>
                                                </StackPanel>
                                                <TextBox x:Name="TaskCronExpression" materialDesign:HintAssist.Hint="Cron ifadesi (örn: 0 0 * * * ? = her saat)" Margin="0,0,0,12"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <TextBox x:Name="TaskErrorEmails" materialDesign:HintAssist.Hint="Hata e-postaları (noktalı virgülle ayırın)" Margin="0,0,0,16"
                                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                <CheckBox x:Name="TaskIsEnabled" Content="Görev etkin" IsChecked="True"
                                                          Style="{StaticResource MaterialDesignCheckBox}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SaveTaskBtn" Click="SaveTaskBtn_Click"
                                                    Style="{StaticResource PrimaryActionButton}" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Görevi Kaydet" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="ConfigSaveBtn" Content="Config Kaydet" Click="ConfigSaveBtn_Click"
                                                    Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,8,0"/>
                                            <Button x:Name="ConfigLoadBtn" Content="Config Yükle" Click="ConfigLoadBtn_Click"
                                                    Style="{StaticResource VisibleOutlinedButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                                <!-- Sağ: Örnek XML -->
                                <Border Grid.Column="1" Padding="20" Margin="12,0,0,0" Background="#334155"
                                        BorderBrush="#475569" BorderThickness="1" CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                            <TextBlock Text="Örnek XML" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            <TextBlock Text=" — Yapıyı referans alın" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button x:Name="LoadSampleXmlBtn" Click="LoadSampleXmlBtn_Click"
                                                        Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Upload" Width="16" Height="16" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Örnek XML Yükle" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="ClearSampleXmlBtn" Click="ClearSampleXmlBtn_Click"
                                                        Style="{StaticResource VisibleTextButton}"
                                                        Content="Temizle"/>
                                            </StackPanel>
                                            <TextBox x:Name="SampleXmlPreview" IsReadOnly="True" TextWrapping="NoWrap"
                                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     FontFamily="Consolas" FontSize="11" Padding="8" MinHeight="200"
                                                     materialDesign:HintAssist.Hint="Örnek XML yükleyin — yapıyı görüp XPath eşleştirmeleri oluşturabilirsiniz"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Background="#1E293B" BorderThickness="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Data Mappings -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="24" Background="#334155"
                                    BorderBrush="#475569" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                        <materialDesign:PackIcon Kind="Table" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#6366F1"/>
                                        <TextBlock Text="Veri Eşleştirmeleri" FontWeight="SemiBold" FontSize="16" Foreground="#F8FAFC"/>
                                        <TextBlock Text=" — XPath → Sütun → SQL tipi" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="0" Margin="0,0,0,16" MinHeight="100">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <DataGrid x:Name="MappingsGrid" MinWidth="950" AutoGenerateColumns="False"
                                                      CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column"
                                                      HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True"
                                                      Style="{StaticResource MaterialDesignDataGrid}"
                                                      Background="Transparent" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="XPath" Binding="{Binding XPath}" MinWidth="280" Width="2*"/>
                                                    <DataGridTextColumn Header="Sütun" Binding="{Binding ColumnName}" MinWidth="150" Width="*"/>
                                                    <DataGridComboBoxColumn Header="SQL Tipi" MinWidth="110" Width="110"
                                                                           SelectedItemBinding="{Binding SqlDataType}"
                                                                           ItemsSource="{Binding Source={StaticResource SqlTypeEnum}}"/>
                                                    <DataGridTextColumn Header="Varsayılan" Binding="{Binding DefaultValue}" MinWidth="110" Width="110"/>
                                                    <DataGridTextColumn Header="Değer Şablonu" Binding="{Binding ValueTemplate}" MinWidth="200" Width="200"
                                                                        ToolTipService.ToolTip="Birden fazla XPath birleştirme: {//XPath1}-{//XPath2} veya {//XPath} SABİT"/>
                                                    <DataGridCheckBoxColumn Header="Sabit" Binding="{Binding IsLiteral}" MinWidth="110" Width="110"/>
                                                    <DataGridTextColumn Header="Bulunacak" Binding="{Binding FindValue}" MinWidth="110" Width="110"/>
                                                    <DataGridTextColumn Header="Yerine" Binding="{Binding ReplaceValue}" MinWidth="110" Width="110"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button x:Name="AddMappingBtn" Click="AddMappingBtn_Click"
                                                Style="{StaticResource VisibleOutlinedButton}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                                                <TextBlock Text="Eşleme Ekle" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="MappingMoveUpBtn" Click="MappingMoveUpBtn_Click"
                                                Style="{StaticResource VisibleTextButton}" Margin="0,0,8,0" Content="Yukarı"/>
                                        <Button x:Name="MappingMoveDownBtn" Click="MappingMoveDownBtn_Click"
                                                Style="{StaticResource VisibleTextButton}" Margin="0,0,12,0" Content="Aşağı"/>
                                        <Button x:Name="SaveMappingsBtn" Click="SaveMappingsBtn_Click"
                                                Style="{StaticResource PrimaryActionButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center"/>
                                                <TextBlock Text="Eşleştirmeleri Kaydet" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Simulation">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="20" Margin="0,0,0,20" Background="#334155" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="LoadXmlBtn" Click="LoadXmlBtn_Click"
                                            Style="{StaticResource PrimaryActionButton}" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileDocument" Width="22" Height="22" VerticalAlignment="Center"/>
                                            <TextBlock Text="XML Yükle" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <ComboBox x:Name="SimTaskCombo" DisplayMemberPath="Name" Width="260" Margin="0,0,16,0"
                                              materialDesign:HintAssist.Hint="Eşleştirme için görev seçin"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              SelectionChanged="SimTaskCombo_SelectionChanged"/>
                                    <TextBlock Text="XPath eşleştirmeleri için bir görev seçin" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Table" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                <TextBlock Text="Ayrıştırılmış Veri" FontWeight="SemiBold" FontSize="15" Foreground="#F8FAFC"/>
                            </StackPanel>
                            <Border Grid.Row="2" Padding="0" Margin="0,0,0,20" Background="#334155" BorderBrush="#475569"
                                    BorderThickness="1" CornerRadius="12">
                                <DataGrid x:Name="ParsedDataGrid" AutoGenerateColumns="True" IsReadOnly="True"
                                          HeadersVisibility="Column" CanUserAddRows="False" MinHeight="120"
                                          Style="{StaticResource MaterialDesignDataGrid}"
                                          Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Database" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#6366F1"/>
                                <TextBlock Text="Üretilen SQL" FontWeight="SemiBold" FontSize="15" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Button x:Name="DryRunBtn" Click="DryRunBtn_Click"
                                        Style="{StaticResource PrimaryActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dry Run (Test)" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Grid.Row="4" Background="#1E293B" CornerRadius="10" Padding="16">
                                <TextBox x:Name="SqlOutput" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" MinHeight="160"
                                         FontFamily="Consolas" FontSize="12" Padding="12"
                                         materialDesign:HintAssist.Hint="SQL çıktısı ve Dry Run sonucu burada görünür"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Background="Transparent" BorderThickness="0"/>
                            </Border>
                        </Grid>
                    </TabItem>
    </TabControl>
    </Grid>
</Window>
